# Public canonical origin. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://orindle.com
# NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase browser-safe publishable configuration (never a service/secret key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only PostgreSQL and optional privileged Supabase Auth administration.
DATABASE_URL=
# SUPABASE_SECRET_KEY=

# Dodo: test mode is deliberate; live mode requires separate launch authorization.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_CREATOR_ID=
DODO_PRODUCT_PRO_ID=
DODO_PRODUCT_STUDIO_ID=

# OpenRouter — the AI provider for chat, image, video and website generation.
# Server-only. Never prefix with NEXT_PUBLIC_: doing so would ship the key to the browser.
OPENROUTER_API_KEY=

# Cloudflare R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Durable jobs run in-process from the outbox table; a scheduler drives GET /api/v1/jobs/tick.
JOBS_TICK_SECRET=

# Isolated website validation and scoped preview deployment.
E2B_API_KEY=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_PREFIX=orindle-site
VERCEL_DEPLOY_TARGET=preview
# AI_ALLOWED_ASSET_HOSTS=

# Transactional email. Abuse limiting uses the rate_limits table; no Redis is required.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=

LOG_LEVEL=info
